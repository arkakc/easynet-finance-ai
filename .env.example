# Database runtime. Use sqlite for local development and postgresql for production.
DATABASE_PROVIDER="sqlite"
# Optional local SQLite override for controlled tooling only.
EASYNET_PRISMA_DATASOURCE_URL=""
# Required when DATABASE_PROVIDER=postgresql and for controlled PostgreSQL migration.
DATABASE_URL_POSTGRES="postgresql://user:password@host:5432/dbname?schema=public&sslmode=require"\n# Production go-live evidence: ISO timestamp of the latest verified managed PostgreSQL backup/PITR check.\nPOSTGRES_BACKUP_VERIFIED_AT=""
BACKUP_RETENTION_COUNT="30"

# NextAuth.js v5
AUTH_SECRET="your-32-character-secret-here-min"
AUTH_URL="http://localhost:3000"

# Server-side compatibility and application session secrets (generate unique values)
APP_SECRET="your-32-character-app-secret-here"
SESSION_SECRET="your-32-character-session-secret-here"
# Use a separate key from SESSION_SECRET in production to seal audit events.
AUDIT_LOG_SECRET="your-separate-32-character-audit-secret-here"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Optional: OpenAI for AI features
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5-mini"

# Document storage (local in dev, S3-compatible in prod)
DOCUMENT_STORAGE_TYPE="local"
#documentStorageType="s3"
#S3_ENDPOINT="https://s3.amazonaws.com"
#S3_BUCKET="easynet-documents"
#S3_ACCESS_KEY="..."
#S3_SECRET_KEY="..."
