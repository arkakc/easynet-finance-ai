  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.0.0",
    "@react-pdf/renderer": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^4.0.0",
    "lucide-react": "^1.5.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^7.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "recharts": "^2.14.0",
    "swr": "^2.3.0",
