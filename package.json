{
  "name": "easynet-finance-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:deferred-revenue": "tsx --test tests/accounting/deferred-revenue-policy.test.ts",
    "db:generate": "npm run db:runtime-client",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backup": "tsx scripts/database/backup.ts",
    "db:reconcile:snapshot": "tsx scripts/database/reconciliation-snapshot.ts",
    "db:sequence:preview": "tsx scripts/database/repair-empty-document-series.ts",
    "db:sequence:repair": "tsx scripts/database/repair-empty-document-series.ts --apply",
    "launch:preflight": "tsx scripts/database/production-launch-preflight.ts",
    "db:uat:deep-audit": "tsx scripts/database/finance-uat-deep-audit.ts",
    "db:uat:close-controls": "tsx scripts/database/finance-close-controls.ts",
    "test:phase8": "tsx --test tests/system/conversion-release-check.test.ts tests/system/recovery-evidence.test.ts tests/system/release-evidence.test.ts tests/system/recovery-resolution.test.ts",
    "test:phase7": "tsx --test tests/reporting/management-insights.test.ts tests/reporting/project-profitability.test.ts tests/reporting/budget-performance.test.ts tests/reporting/forward-finance.test.ts",
    "test:phase6": "tsx --test tests/accounting/phase6-flow-invariants.test.ts tests/erp/conversion-guard-concurrency.test.ts tests/erp/conversion-response.test.ts tests/erp/phase6-partial-write-workflow.test.ts tests/erp/transaction-automation-preview.test.ts tests/erp/intelligent-next-actions.test.ts tests/documents/safe-document-links.test.ts",
    "db:phase6:release-readiness": "tsx scripts/database/phase6-release-readiness.ts",
    "db:phase8:verify-postgres": "tsx scripts/database/verify-phase6-postgres-claims.ts",
    "db:phase6:verify-postgres": "tsx scripts/database/verify-phase6-postgres-claims.ts",
    "db:phase6:verify-isolated": "tsx scripts/database/verify-phase6-conversion-claims.ts",
    "db:uat:po-diagnose": "tsx scripts/database/diagnose-po-commitment.ts",
    "db:reconcile:control-preview": "tsx scripts/database/reclassify-historical-control-accounts.ts",
    "db:reconcile:control-apply": "tsx scripts/database/reclassify-historical-control-accounts.ts --apply",
    "db:repair:bank-mappings": "tsx scripts/database/backfill-bank-ledger-mappings.ts",
    "db:postgres:schema": "tsx scripts/database/generate-postgres-schema.ts",
    "db:postgres:validate": "npm run db:postgres:schema && tsx scripts/database/validate-postgres-schema.ts",
    "db:postgres:client": "npm run db:runtime-client",
    "hash-password": "tsx scripts/hash-password.ts",
    "lint": "eslint .",
    "payment-allocations:preview": "tsx scripts/backfill-payment-allocations.ts",
    "payment-allocations:backfill": "tsx scripts/backfill-payment-allocations.ts --apply",
    "warehouse-stock:preview": "tsx scripts/backfill-warehouse-stock.ts",
    "warehouse-stock:backfill": "tsx scripts/backfill-warehouse-stock.ts --apply",
    "multi-currency:preview": "tsx scripts/backfill-multi-currency.ts",
    "multi-currency:backfill": "tsx scripts/backfill-multi-currency.ts --apply",
    "db:clients": "npm run db:runtime-client",
    "predev": "npm run db:runtime-client",
    "prebuild": "npm run clean:next && npm run db:runtime-client",
    "pretypecheck": "npm run clean:next && npm run db:runtime-client",
    "clean:next": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "db:runtime-client": "tsx scripts/database/generate-runtime-client.ts",
    "db:backup:list": "tsx scripts/database/backup.ts --list",
    "db:backup:prune": "tsx scripts/database/backup.ts --prune",
    "test:finance-setup": "node --require ./tests/support/node-server-only-shim.cjs --env-file=.env.local --import tsx --test tests/accounting/finance-setup-wizard.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.0.0",
    "@react-pdf/renderer": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^4.0.0",
    "lucide-react": "^1.5.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^7.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "recharts": "^2.14.0",
    "swr": "^2.3.0",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
