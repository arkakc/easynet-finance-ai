    "test:financial-statements": "tsx tests/financial-statements-uat.ts",
    "test:cash-flow": "tsx tests/cash-flow-uat.ts",
    "test:subledger-recovery": "tsx tests/subledger-recovery-uat.ts",
    "test:opening-subledger": "tsx tests/opening-subledger-uat.ts",
    "test:payroll": "tsx tests/payroll-uat.ts",
    "test:gst": "tsx tests/gst-uat.ts",
    "test:stock-assets": "tsx tests/stock-assets-uat.ts",
    "test:financial-reconciliation": "tsx tests/financial-reconciliation-uat.ts",
    "test:go-live": "tsx tests/go-live-uat.ts",
    "test:health": "tsx tests/health-uat.ts",
    "test:master-reset": "tsx tests/master-reset-uat.ts",
    "test:master-reset-api": "tsx tests/master-reset-api-uat.ts",
    "test:transaction-reset": "tsx tests/transaction-reset-uat.ts",
    "test:coa-import": "tsx tests/coa-import-uat.ts",
