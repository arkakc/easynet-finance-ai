    "db:postgres:schema": "tsx scripts/database/generate-postgres-schema.ts",
    "db:postgres:validate": "npm run db:postgres:schema && tsx scripts/database/validate-postgres-schema.ts",
    "db:postgres:client": "npm run db:postgres:schema && tsx scripts/database/generate-postgres-client.ts",
    "db:postgres:preflight": "npm run db:postgres:client && tsx scripts/database/postgres-transfer.ts --mode=preflight",
    "db:postgres:transfer": "npm run db:postgres:client && tsx scripts/database/postgres-transfer.ts --mode=transfer",
    "hash-password": "tsx scripts/hash-password.ts",
    "lint": "eslint .",
    "test:period-close": "tsx tests/period-close-uat.ts",
    "test:journal-reversal": "tsx tests/journal-reversal-uat.ts",
    "test:single-source": "tsx tests/single-source-of-truth-uat.ts",
    "test:atomic-posting": "tsx tests/atomic-posting-uat.ts",
    "test:atomic-payment": "tsx tests/atomic-payment-uat.ts",
    "test:atomic-sales-invoice": "tsx tests/atomic-sales-invoice-uat.ts",
