    "test:atomic-expense": "tsx tests/atomic-expense-uat.ts",
    "test:atomic-stock": "tsx tests/atomic-stock-uat.ts",
    "test:atomic-partial-advance": "tsx tests/atomic-partial-advance-uat.ts",
    "test:atomic-sales-return": "tsx tests/atomic-sales-return-uat.ts",
    "test:manual-journal-approval": "tsx tests/manual-journal-approval-uat.ts",
    "payment-allocations:preview": "tsx scripts/backfill-payment-allocations.ts",
